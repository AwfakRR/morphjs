{
  "name": "morphjs",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "animejs": ">=4.0.0",
    "motion": ">=11.0.0",
    "gsap": ">=3.12.0"
  },
  "peerDependenciesMeta": {
    "animejs": {
      "optional": true
    },
    "motion": {
      "optional": true
    },
    "gsap": {
      "optional": true
    }
  },
  "devDependencies": {
    "animejs": ">=4.0.0",
    "motion": ">=11.0.0",
    "gsap": ">=3.12.0",
    "vite": "~6.0.0",
    "vite-plugin-dts": "^4.2.1"
  }
}
